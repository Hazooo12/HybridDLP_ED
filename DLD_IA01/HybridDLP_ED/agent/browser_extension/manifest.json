{
  "manifest_version": 3,
  "name": "DLP Browser Upload Monitor",
  "version": "1.0.0",
  "description": "Monitors file upload events in the browser and forwards to local DLP sensor pipeline via Native Messaging.",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "storage",
    "webRequest",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "DLP Upload Monitor",
    "default_popup": ""
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
